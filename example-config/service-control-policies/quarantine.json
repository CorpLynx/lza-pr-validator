{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QuarantineNewAccounts",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/AWSControlTowerExecution",
            "arn:aws:iam::*:role/AWSAccelerator*"
          ]
        }
      }
    }
  ]
}
